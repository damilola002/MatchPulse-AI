# Local development configuration only. Set a non-empty unique local password before starting Compose.
# Do not use these values in deployed environments or commit a populated .env file.
POSTGRES_DB=matchpulse
POSTGRES_USER=matchpulse
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5434
# PostgreSQL integration tests require both values and verify the database differs from development.
MATCHPULSE_TEST_DATABASE_URL=
MATCHPULSE_TEST_DATABASE_NAME=
# Alembic requires an explicit target; use development or test.
MATCHPULSE_MIGRATION_TARGET=
# For test migrations, repeat the exact designated test database name deliberately.
MATCHPULSE_TEST_MIGRATION_CONFIRM=
