# Local development configuration only. Set a non-empty unique local password before starting Compose.
# Do not use these values in deployed environments or commit a populated .env file.
POSTGRES_DB=matchpulse
POSTGRES_USER=matchpulse
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5434
# PostgreSQL integration tests require both values and verify the database differs from development.
MATCHPULSE_TEST_DATABASE_URL=
MATCHPULSE_TEST_DATABASE_NAME=
# Alembic requires an explicit target; use development or test.
MATCHPULSE_MIGRATION_TARGET=
# For test migrations, repeat the exact designated test database name deliberately.
MATCHPULSE_TEST_MIGRATION_CONFIRM=
# Optional only when the Phase 3 intelligence endpoint is used; set a stable,
# unpadded base64url encoding of at least 32 random bytes in untracked .env.
MATCHPULSE_INTELLIGENCE_CURSOR_KEY=
# Optional Phase 4 provider configuration. Keep credentials in this untracked
# file or a runtime secret store; tests never call a live Azure provider.
MATCHPULSE_AZURE_OPENAI_ENDPOINT=
MATCHPULSE_AZURE_OPENAI_DEPLOYMENT=
MATCHPULSE_AZURE_OPENAI_API_KEY=
MATCHPULSE_NARRATIVE_MAX_INSIGHTS=10
MATCHPULSE_NARRATIVE_MAX_CLAIMS=20
MATCHPULSE_NARRATIVE_MAX_REQUEST_BYTES=262144
MATCHPULSE_NARRATIVE_MAX_RESPONSE_BYTES=65536
MATCHPULSE_NARRATIVE_MAX_OUTPUT_TOKENS=512
MATCHPULSE_NARRATIVE_MAX_CONCURRENCY=4
# The local narrative POST route is disabled unless explicitly enabled.
MATCHPULSE_DEMO_MODE=false
# Deterministic local provider is the default; Azure requires explicit selection.
MATCHPULSE_NARRATIVE_PROVIDER=fake
